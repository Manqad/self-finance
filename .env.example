# Optional Gmail IMAP Fallback (60-second setup alternative to OAuth2 credentials.json)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gmail OAuth2 paths (default: workspace root)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# SQLite Database Path
TREASURY_DB_PATH=data/treasury.db

# App Lock Screen Authentication (recommended for Streamlit Cloud & mobile access)
# Either set TREASURY_APP_PASSWORD_HASH (recommended: python -c "from src.security import hash_password; print(hash_password('your-pass'))")
# or TREASURY_APP_PASSWORD for single-user PIN/password protection. Leave both blank to disable local auth.
TREASURY_APP_PASSWORD=
TREASURY_APP_PASSWORD_HASH=
TREASURY_SESSION_TIMEOUT_MINUTES=15

# Zero-Trust Encrypted Backups & Cloud Vault Persistence (survives Streamlit Cloud container restarts)
# Passphrase used for AES/Fernet encrypted .enc backups & cloud vault sync (falls back to TREASURY_APP_PASSWORD if blank)
TREASURY_BACKUP_KEY=
# Cloud vault mode: "gist" (automatic if token + gist ID set), "gmail" (stores encrypted vault in Gmail INBOX), or "off"
TREASURY_CLOUD_SYNC=
TREASURY_AUTO_RESTORE=1
# Option A (Recommended): Private GitHub Gist vault (create a Secret Gist + fine-grained PAT with gist read/write scope)
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_GIST_ID=

