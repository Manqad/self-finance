# Copy these settings into Streamlit Community Cloud -> App Settings -> Secrets
# Never commit a real .streamlit/secrets.toml file to Git (.streamlit/secrets.toml is gitignored).

# 1. App Lock Screen (Required for public Streamlit Cloud URL protection)
# Generate hash locally: .venv\Scripts\python.exe -c "from src.security import hash_password; print(hash_password('YOUR_STRONG_PASS'))"
TREASURY_APP_PASSWORD_HASH = ""
# Alternative plaintext password (also used as fallback encryption key if TREASURY_BACKUP_KEY is omitted)
TREASURY_APP_PASSWORD = ""
# Auto-lock after N minutes of inactivity (default: 15)
TREASURY_SESSION_TIMEOUT_MINUTES = "15"

# 2. Encrypted Backup & Zero-Trust Cloud Vault Key
# Separate strong passphrase for encrypting ledger snapshots before uploading to cloud storage
TREASURY_BACKUP_KEY = ""
TREASURY_AUTO_RESTORE = "1"

# 3A. Option A (Recommended Free 24/7 Cloud Persistence): Private GitHub Gist Vault
# Create a Private/Secret Gist and a GitHub Personal Access Token with ONLY the "gist" permission
GITHUB_BACKUP_TOKEN = ""
GITHUB_BACKUP_GIST_ID = ""

# 3B. Option B (Alternative Zero-Config Cloud Persistence): Encrypted Gmail Self-Vault
# Stores encrypted snapshots in your Gmail INBOX via IMAP. Set TREASURY_CLOUD_SYNC = "gmail"
TREASURY_CLOUD_SYNC = ""

# 4. Gmail Bank Alert Ingestion (16-char Google App Password with 2FA enabled)
GMAIL_USER = ""
GMAIL_APP_PASSWORD = ""
GMAIL_CREDENTIALS_PATH = "credentials.json"
GMAIL_TOKEN_PATH = "token.json"

# 5. Database Path inside Streamlit Cloud container
TREASURY_DB_PATH = "data/treasury.db"

